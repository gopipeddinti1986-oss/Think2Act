# Think2Act Platform Environment Configuration
# Duplicate this file to .env and adjust variables for your environment

# Environment Mode: development | production | test
ENVIRONMENT=development

# Database Configuration
# Local SQLite (default for development):
DATABASE_URL=sqlite+aiosqlite:///./think2act.db
# Production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://think2act:think2act_password@localhost:5432/think2act_db

# JWT Security
# WARNING: Must be changed to a cryptographically secure random string in production!
JWT_SECRET=think2act_dev_secret_key_2026_local_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (optional for caching/queues)
REDIS_URL=redis://localhost:6379/0

# AI Provider Abstraction
# Options: mock | groq | openai | gemini
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# Object Storage (S3 / MinIO for documents/resumes)
STORAGE_ENDPOINT=
STORAGE_BUCKET=think2act-documents
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Frontend Configuration
VITE_API_URL=/api/v1
